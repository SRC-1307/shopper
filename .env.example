# ── Google Cloud ──────────────────────────────────────────────────────────────
# Path to your GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/service-account-key.json"

# Your Google Cloud / Dialogflow project ID (found in GCP console)
DIALOGFLOW_PROJECT_ID="your-gcp-project-id"

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shopper-DB

# ── Cloud Run (Cloud SQL socket — leave empty for local development) ───────────
DB_SOCKET=
